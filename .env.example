NODE_ENV=production
PORT=5510
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_RESET_KEY=replace-with-a-random-reset-key-of-at-least-20-characters
# Vercel adds this automatically when a public Blob store is connected.
BLOB_READ_WRITE_TOKEN=
# Only used by traditional Node hosting; Vercel uses Blob storage.
DATA_DIR=./data
